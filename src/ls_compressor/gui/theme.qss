* {{
    color: {TEXT_PRIMARY};
    font-family: "{FONT_UI}", -apple-system, "Segoe UI", sans-serif;
    font-size: 12px;
    selection-background-color: {BG_SURFACE_ALT};
    selection-color: {TEXT_PRIMARY};
}}
QMainWindow, QDialog, QWidget#centralWidget, QWidget#contentArea {{
    background: {BG_APP};
}}
QWidget#sidebar {{
    background: {BG_SIDEBAR};
    border-right: 1px solid {BORDER_STRONG};
}}
QWidget#logoTile {{
    background: {BG_NAV_ACTIVE};
    border-radius: 6px;
}}
QLabel {{ background: transparent; }}
QLabel#logoText {{ color: {TEXT_PRIMARY}; font-size: 12.5px; font-weight: 500; }}
QLabel[role="title"] {{ color: {TEXT_PRIMARY}; font-size: 14px; font-weight: 500; }}
QLabel[role="subtitle"] {{ color: {TEXT_TERTIARY}; font-size: 11.5px; }}
QPushButton {{
    min-height: 32px;
    border-radius: 6px;
    padding: 0 11px;
    font-size: 11.5px;
    font-weight: 400;
    background: {BG_SURFACE};
    border: 1px solid {BORDER_STRONG};
    color: {TEXT_PRIMARY};
}}
QPushButton:hover {{ background: {BG_NAV_ACTIVE}; }}
QPushButton[variant="primary"] {{
    background: {ACCENT};
    border: none;
    color: {ACCENT_ON};
    padding: 0 15px;
    font-weight: 500;
}}
QPushButton[variant="primary"]:hover {{ background: {ACCENT}; }}
QPushButton[variant="secondary"] {{
    background: transparent;
    border: 1px solid {BORDER_STRONG};
    color: {TEXT_SECONDARY};
}}
QPushButton[variant="secondary"]:hover {{ background: {BG_NAV_ACTIVE}; }}
QPushButton[variant="ghost"] {{ background: transparent; border: none; color: {TEXT_MUTED}; }}
QPushButton[variant="ghost"]:hover {{ background: {BG_NAV_ACTIVE}; color: {TEXT_SECONDARY}; }}
QPushButton[variant="nav"] {{
    background: transparent;
    border: none;
    color: {TEXT_MUTED};
    text-align: left;
    padding: 7px 10px;
    min-height: 30px;
    border-radius: 6px;
    font-size: 12px;
}}
QPushButton[variant="nav"]:hover {{ background: {BG_NAV_ACTIVE}; color: {TEXT_SECONDARY}; }}
QPushButton[variant="nav"][active="true"] {{ background: {BG_NAV_ACTIVE}; color: {TEXT_PRIMARY}; }}
QComboBox {{
    background: {BG_SURFACE};
    border: 1px solid {BORDER_STRONG};
    border-radius: 6px;
    color: {TEXT_SECONDARY};
    padding: 0 28px 0 10px;
    min-height: 32px;
    font-size: 11.5px;
}}
QComboBox:hover {{ border-color: {BORDER_DASHED}; }}
QComboBox::drop-down {{ border: none; width: 24px; }}
QComboBox::down-arrow {{ image: none; }}
QComboBox QAbstractItemView {{
    background: {BG_SURFACE};
    border: 1px solid {BORDER_STRONG};
    outline: none;
    selection-background-color: {BG_NAV_ACTIVE};
    selection-color: {TEXT_PRIMARY};
}}
QWidget#dropArea {{
    background: transparent;
    border: 1px dashed {BORDER_DASHED};
    border-radius: 8px;
}}
QWidget#dropArea[active="true"] {{ background: {BG_SURFACE}; border-color: {TEXT_DISABLED}; }}
QLabel#dropText {{ color: {TEXT_MUTED}; font-size: 11.5px; }}
QWidget#tableContainer {{
    background: {BG_APP};
    border: 1px solid {BORDER_STRONG};
    border-radius: 8px;
}}
QTableWidget#jobTable {{
    background: transparent;
    border: 1px solid {BORDER_STRONG};
    border-radius: 8px;
    outline: none;
    gridline-color: transparent;
}}
QTableWidget#jobTable::item {{
    background: transparent;
    border: none;
    border-bottom: 1px solid {BORDER_ROW};
    padding: 0 16px;
}}
QTableWidget#jobTable::item:selected {{ background: {BG_SURFACE_ALT}; color: {TEXT_PRIMARY}; }}
QHeaderView {{ background: {BG_APP}; }}
QHeaderView::section {{
    background: {BG_TABLE_HEADER};
    color: {TEXT_MUTED};
    border: none;
    border-bottom: 1px solid {BORDER};
    padding: 0 16px;
    font-size: 10px;
    font-weight: 400;
}}
QWidget#statCard {{
    background: {BG_SURFACE};
    border: 1px solid {BORDER};
    border-radius: 8px;
}}
QLabel[role="statLabel"] {{ color: {TEXT_MUTED}; font-size: 10px; font-weight: 400; }}
QLabel[role="statValue"] {{ color: {TEXT_PRIMARY}; font-size: 16px; font-weight: 500; }}
QLabel[role="statUnit"] {{ color: {TEXT_MUTED}; font-size: 11px; font-weight: 400; }}
QLineEdit, QSpinBox {{
    background: {BG_SURFACE};
    border: 1px solid {BORDER_STRONG};
    border-radius: 6px;
    color: {TEXT_SECONDARY};
    min-height: 32px;
    padding: 0 10px;
}}
QListWidget {{
    background: {BG_SURFACE};
    border: 1px solid {BORDER_STRONG};
    border-radius: 6px;
    color: {TEXT_PRIMARY};
    outline: none;
    padding: 4px;
}}
QListWidget::item {{
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 8px 12px;
}}
QListWidget::item:selected {{
    background: {BG_NAV_ACTIVE};
    color: {TEXT_PRIMARY};
}}
QListWidget::item:hover:!selected {{
    background: {BG_SURFACE_ALT};
}}
QRadioButton {{ color: {TEXT_SECONDARY}; spacing: 8px; }}
QRadioButton::indicator {{ width: 14px; height: 14px; border: 1px solid {BORDER_STRONG}; border-radius: 7px; background: {BG_SURFACE}; }}
QRadioButton::indicator:checked {{ background: {ACCENT}; border: 4px solid {BG_SURFACE}; }}
QScrollBar:vertical {{ background: {BG_APP}; width: 8px; }}
QScrollBar::handle:vertical {{ background: {BORDER_STRONG}; border-radius: 4px; min-height: 24px; }}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{ height: 0; }}
QScrollBar:horizontal {{ background: {BG_APP}; height: 8px; }}
QScrollBar::handle:horizontal {{ background: {BORDER_STRONG}; border-radius: 4px; min-width: 24px; }}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {{ width: 0; }}
QToolTip {{ background: {BG_SURFACE}; color: {TEXT_SECONDARY}; border: 1px solid {BORDER_STRONG}; padding: 4px 8px; }}
QMessageBox {{ background: {BG_APP}; }}
